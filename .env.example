# Copy to .env for local use. On Railway, set these under the service's Variables tab.

# Required. From console.anthropic.com -> API Keys. Server-side only; never sent to the browser.
ANTHROPIC_API_KEY=

# Model settings
ICB_MODEL=claude-opus-5
ICB_EFFORT=high

# Where profiles, criteria packs, decision logs and scorecards live.
# Local: ./investors   Railway: a path on a mounted volume, e.g. /data/investors
ICB_DATA_DIR=./investors
# Extraction cache. Local: leave empty for the platform cache dir. Railway: /data/cache
ICB_CACHE_DIR=

# Result emails via Resend. Emailing is on only when RESEND_API_KEY and ICB_REPORT_EMAIL_TO are both set.
# Key: resend.com/api-keys (Sending access). The FROM domain must be verified in Resend.
RESEND_API_KEY=
ICB_REPORT_EMAIL_TO=Info@tencapital.group
ICB_REPORT_EMAIL_FROM=icb@tencapital.group

# Web app (open access: no sign-in)
MAX_UPLOAD_MB=25
MAX_CONCURRENT_JOBS=2
JOB_TTL_MINUTES=180
